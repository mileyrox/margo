modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
SWAP_CATALOG_ADMIN_EMAILS = "mileywagner12@gmail.com"

[userenv.production]
PLAID_ENV = "production"

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-7678970e-bb4e-42c3-a235-9a91f4234091"
